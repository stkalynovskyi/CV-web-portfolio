---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activePage?: string;
}

const {
  title = 'Stanislav Kalynovskyi — Desarrollador Full-Stack',
  description = 'Portfolio de Stanislav Kalynovskyi, Desarrollador Full-Stack con C#, .NET, React y Node.js. Basado en Valencia, España.',
  activePage = '',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Stanislav Kalynovskyi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <slot />

    <div style="position: fixed; bottom: 1.5rem; right: 2rem; z-index: 50; pointer-events: none; opacity: 0.35;">
      <p style="font-family: var(--font-body); font-size: 0.65rem; color: var(--text-1); letter-spacing: 0.05em; text-align: right;">
        &copy; {new Date().getFullYear()} Stanislav Kalynovskyi<br />Todos los derechos reservados.
      </p>
    </div>
  </body>
</html>
